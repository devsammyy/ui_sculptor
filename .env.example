# Open-weight model infrastructure (vLLM or Ollama)
VLLM_BASE_URL=http://localhost:8000
OLLAMA_BASE_URL=http://localhost:11434

# Meta Model APIs (Hosted)
SAM_API_URL=http://localhost:8001
MUSE_WONDER_API_URL=http://localhost:8002
MUSE_VOICE_API_URL=http://localhost:8003

# Meta API Keys (for hosted models)
META_API_KEY=your_meta_api_key_here

# Feature flags
NEXT_PUBLIC_ENABLE_3D=true
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_SAM=true

# Development
NODE_ENV=development