# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build
/dist

# Production & Packaging
*.tgz
*.tar.gz

# Environment Variables & Secrets
# (Never commit actual credentials, API tokens, or secrets)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
/coverage
/.nyc_output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-mcp

# TypeScript
*.tsbuildinfo

# Build Caches & Compilers
.swc/
.turbo/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# IDEs & Editor Configuration
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# VS Code (ignore workspace state, allow shared recommendations)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary Verification & Test Screenshots
*_ui.png
*studio*.png
desktop_*.png
target_selected_*.png

